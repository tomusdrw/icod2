{
  "name": "@icod2/be",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "yarn copy-configs && tsx watch src/index.ts",
    "copy-configs": "copyfiles 'config.*.{json,yaml,yml}' 'config.{json,yaml,yml}' dist/",
    "type-check": "tsc --noEmit",
    "build": "yarn copy-configs && tsc --build tsconfig.json",
    "build-force": "yarn copy-configs && tsc --build tsconfig.json --force",
    "lint": "yarn run -T biome check",
    "lint:fix": "yarn run -T biome check --write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@axiomhq/pino": "^2.0.0",
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@icod2/protocols": "workspace:*",
    "@libp2p/autonat": "^3.0.33",
    "@libp2p/circuit-relay-v2": "^4.2.18",
    "@libp2p/crypto": "^5.2.0",
    "@libp2p/gossipsub": "^17.2.2",
    "@libp2p/identify": "^4.1.19",
    "@libp2p/interface": "^3.4.0",
    "@libp2p/peer-id": "^6.0.18",
    "@libp2p/peer-id-factory": "^4.2.4",
    "@libp2p/tcp": "^11.0.33",
    "@libp2p/websockets": "^10.1.26",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.11",
    "@types/pino": "^7.0.5",
    "js-yaml": "^5.5.0",
    "libp2p": "^3.5.2",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/copyfiles": "^2",
    "copyfiles": "^2.4.1"
  },
  "packageManager": "yarn@4.19.0"
}
