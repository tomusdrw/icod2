{
  "name": "@icod2/fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --build tsconfig.app.json && vite build",
    "build:analyze": "tsc --build tsconfig.app.json && vite build --mode analyze",
    "build-force": "tsc --build --force tsconfig.app.json && vite build",
    "lint": "yarn run -T biome check",
    "lint:fix": "yarn run -T biome check --write",
    "type-check": "tsc --noEmit --project tsconfig.app.json",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/bootstrap": "^12.0.37",
    "@libp2p/circuit-relay-v2": "^4.2.18",
    "@libp2p/gossipsub": "^17.2.2",
    "@libp2p/identify": "^4.1.19",
    "@libp2p/ping": "3.1.18",
    "@libp2p/pubsub-peer-discovery": "^12.0.0",
    "@libp2p/webrtc": "^7.0.3",
    "@libp2p/websockets": "^10.1.26",
    "@libp2p/webtransport": "^6.0.45",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/themes": "^3.3.0",
    "@redux-devtools/extension": "^4.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "date-fns": "^4.4.0",
    "detect-browser": "^5.3.0",
    "icod-crypto-js": "workspace:*",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.7",
    "rollup-plugin-visualizer": "^7.3.0",
    "tailwind-merge": "^3.7.1",
    "ua-parser-js": "^2.0.10",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "packageManager": "yarn@4.19.0"
}
